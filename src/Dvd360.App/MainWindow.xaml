<Window x:Class="Dvd360.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dvd360.App"
        Title="DVD 360" Width="1220" Height="820" MinWidth="980" MinHeight="680"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,14">
            <Button local:Ico.Glyph="&#xE774;" DockPanel.Dock="Right" Content="{Binding [Lang], Source={x:Static local:Loc.I}}" Click="Lang_Click" Padding="12,6" Margin="0"/>
            <Button local:Ico.Glyph="&#xE896;" x:Name="UpdateButton" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource Primary}" Click="Update_Click" Padding="12,6" Margin="0,0,10,0"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DVD 360" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{Binding [AppSubtitle], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,5"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left: disc -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBox}" Padding="16,24,16,40">
                        <local:DiscView x:Name="Disc" Width="300" Height="300"/>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding [Drive], Source={x:Static local:Loc.I}}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                <Button local:Ico.Glyph="&#xE72C;" DockPanel.Dock="Right" Content="{Binding [Refresh], Source={x:Static local:Loc.I}}" Click="Refresh_Click" Margin="0" Padding="10,5" HorizontalAlignment="Right"/>
                                <ComboBox x:Name="DriveBox" Margin="12,0,10,0" SelectionChanged="DriveBox_SelectionChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="DiscStatus" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid x:Name="InfoGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding [Media], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Column="1" x:Name="InfoMedia"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{Binding [Label], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoLabel"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="{Binding [Size], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoSize"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="{Binding [Tracks], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoTracks"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Text="{Binding [DriveModel], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoDrive"/>
                                <TextBlock Grid.Row="5" Style="{StaticResource Muted}" Text="{Binding [Written], Source={x:Static local:Loc.I}}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoWritten"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InfoAge" Style="{StaticResource Muted}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FileInfoCard" Style="{StaticResource CardBox}" Visibility="Collapsed" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border x:Name="DetailTile" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                                    <TextBlock x:Name="DetailGlyph" FontFamily="{StaticResource Icons}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DetailChip" DockPanel.Dock="Right" CornerRadius="11" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailChipText" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FileInfoName" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="FileInfoState" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Height="6" CornerRadius="3" Background="#0C111B" ClipToBounds="True" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="DetOk" Width="0*"/>
                                        <ColumnDefinition x:Name="DetErr" Width="0*"/>
                                        <ColumnDefinition x:Name="DetRest" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource OkBrush}"/>
                                    <Border Grid.Column="1" Background="{StaticResource RetryBrush}"/>
                                </Grid>
                            </Border>
                            <Grid x:Name="DetailsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="4,0">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" Margin="0,0,5,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [LegendOk], Source={x:Static local:Loc.I}}" Margin="0,0,14,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource RetryBrush}" Margin="0,0,5,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [LegendRetry], Source={x:Static local:Loc.I}}" Margin="0,0,14,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource DeadBrush}" Margin="0,0,5,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [LegendBad], Source={x:Static local:Loc.I}}" Margin="0,0,14,0"/>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource WaitBrush}" Margin="0,0,5,0"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [LegendWait], Source={x:Static local:Loc.I}}"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- right: tabs -->
            <TabControl Grid.Column="2" x:Name="Tabs">
                <!-- RESCUE -->
                <TabItem Header="{Binding [TabRescue], Source={x:Static local:Loc.I}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding [RescueMode], Source={x:Static local:Loc.I}}"/>
                                <WrapPanel Margin="0,0,0,14">
                                    <RadioButton x:Name="ModeWhole" GroupName="mode" IsChecked="True" Foreground="{StaticResource Text}" Margin="0,0,24,0" VerticalContentAlignment="Center"
                                                 Content="{Binding [ModeWhole], Source={x:Static local:Loc.I}}" Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeMedia" GroupName="mode" Foreground="{StaticResource Text}" Margin="0,0,24,0" VerticalContentAlignment="Center"
                                                 Content="{Binding [ModeMedia], Source={x:Static local:Loc.I}}" Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeSelected" GroupName="mode" Foreground="{StaticResource Text}" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                                 Content="{Binding [ModeSelected], Source={x:Static local:Loc.I}}" Checked="Mode_Changed"/>
                                    <Button local:Ico.Glyph="&#xE8B7;" x:Name="PickButton" Content="{Binding [PickInContents], Source={x:Static local:Loc.I}}" Click="PickInContents_Click" Padding="10,4" Margin="0"/>
                                    <TextBlock x:Name="SelectionText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding [SaveTo], Source={x:Static local:Loc.I}}"/>
                                <DockPanel>
                                    <Button local:Ico.Glyph="&#xE8DA;" DockPanel.Dock="Right" Content="{Binding [Choose], Source={x:Static local:Loc.I}}" Click="ChooseFolder_Click" Margin="8,0,0,0"/>
                                    <TextBox x:Name="FolderBox" TextChanged="Target_Changed"/>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding [ImageName], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="80"/>
                                    <TextBlock x:Name="ExtText" DockPanel.Dock="Right" Text=".bin" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource Muted}"/>
                                    <TextBox x:Name="NameBox" TextChanged="Target_Changed"/>
                                </DockPanel>
                                <TextBlock x:Name="SpaceText" Style="{StaticResource Muted}" Margin="80,6,0,0"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [Retries], Source={x:Static local:Loc.I}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="RetrySlider" Minimum="1" Maximum="30" Value="5" Width="160" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value, ElementName=RetrySlider}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [Speed], Source={x:Static local:Loc.I}}"/>
                                        <ComboBox x:Name="SpeedBox" SelectedIndex="0" MinWidth="190">
                                            <ComboBoxItem Content="{Binding [SpeedAuto], Source={x:Static local:Loc.I}}" Tag="auto"/>
                                            <ComboBoxItem Content="{Binding [SpeedMax], Source={x:Static local:Loc.I}}" Tag="0"/>
                                            <ComboBoxItem Content="16x" Tag="16"/>
                                            <ComboBoxItem Content="8x" Tag="8"/>
                                            <ComboBoxItem Content="4x" Tag="4"/>
                                            <ComboBoxItem Content="2x" Tag="2"/>
                                            <ComboBoxItem Content="1x" Tag="1"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [SpeedHint], Source={x:Static local:Loc.I}}" FontSize="11" MaxWidth="200"/>
                                    </StackPanel>
                                    <CheckBox x:Name="VerifyBox" IsChecked="True" VerticalAlignment="Center" Content="{Binding [Verify], Source={x:Static local:Loc.I}}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <Button local:Ico.Glyph="&#xE945;" x:Name="OneClickButton" Style="{StaticResource Primary}" Background="#16A34A" BorderBrush="#16A34A" Click="OneClick_Click"
                                    Content="{Binding [OneClick], Source={x:Static local:Loc.I}}" ToolTip="{Binding [OneClickTip], Source={x:Static local:Loc.I}}"/>
                            <Button local:Ico.Glyph="&#xE768;" x:Name="StartButton" Style="{StaticResource Primary}" Content="{Binding [Start], Source={x:Static local:Loc.I}}" Click="Start_Click"/>
                            <Button local:Ico.Glyph="&#xE71A;" x:Name="StopButton" Style="{StaticResource Danger}" Content="{Binding [Stop], Source={x:Static local:Loc.I}}" Click="Stop_Click" IsEnabled="False"/>
                            <Button local:Ico.Glyph="&#xE72C;" x:Name="RetryButton" Content="{Binding [RetryBad], Source={x:Static local:Loc.I}}" Click="RetryBad_Click" IsEnabled="False"/>
                            <Button local:Ico.Glyph="&#xE958;" x:Name="RescueIsoButton" Content="{Binding [SaveIso], Source={x:Static local:Loc.I}}" Click="RescueSaveIso_Click"/>
                            <Button local:Ico.Glyph="&#xE838;" Content="{Binding [OpenFolder], Source={x:Static local:Loc.I}}" Click="OpenFolder_Click"/>
                            <Button local:Ico.Glyph="&#xE9F9;" x:Name="ReportButton" Content="{Binding [Report], Source={x:Static local:Loc.I}}" Click="Report_Click"/>
                            <CheckBox x:Name="AutoIsoBox" IsChecked="True" VerticalAlignment="Center" Margin="4,0,16,8" Content="{Binding [AutoIso], Source={x:Static local:Loc.I}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center" ToolTip="{Binding [WhenDoneTip], Source={x:Static local:Loc.I}}">
                                <TextBlock Text="{Binding [WhenDone], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FinishBox" SelectedIndex="0" MinWidth="170">
                                    <ComboBoxItem Content="{Binding [Power_None], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [Power_Sleep], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [Power_Hibernate], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [Power_Shutdown], Source={x:Static local:Loc.I}}"/>
                                </ComboBox>
                                <CheckBox x:Name="EjectBox" VerticalAlignment="Center" Margin="12,0,0,0" Content="{Binding [EjectWhenDone], Source={x:Static local:Loc.I}}"/>
                            </StackPanel>
                        </WrapPanel>

                        <Border Grid.Row="2" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="PassText" Style="{StaticResource H2}" Text="{Binding [Pass_Idle], Source={x:Static local:Loc.I}}"/>
                                </DockPanel>
                                <!-- filled (green) | errors (red) | unread (grey), shown separately -->
                                <Border CornerRadius="5" Height="12" Background="#0F1522" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="SegOk" Width="0*"/>
                                            <ColumnDefinition x:Name="SegErr" Width="0*"/>
                                            <ColumnDefinition x:Name="SegRest" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource OkBrush}"/>
                                        <Border Grid.Column="1" Background="{StaticResource RetryBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="BarLegend" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                <UniformGrid Columns="6" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatOk], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatOk" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatBad], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatBad" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RetryBrush}" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatPending], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatPending" FontSize="16" FontWeight="SemiBold" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatSpeed], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatSpeed" FontSize="16" FontWeight="SemiBold" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatElapsed], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatElapsed" FontSize="16" FontWeight="SemiBold" Text="—"/></StackPanel>
                                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="{Binding [StatEta], Source={x:Static local:Loc.I}}"/><TextBlock x:Name="StatEta" FontSize="16" FontWeight="SemiBold" Text="—"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="3" x:Name="LogList" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="1"/>
                    </Grid>
                </TabItem>

                <!-- CONTENTS -->
                <TabItem Header="{Binding [TabContent], Source={x:Static local:Loc.I}}">
                    <Grid>
                        <Grid.Resources>
                            <ContextMenu x:Key="FileMenu" Opened="TreeMenu_Opened">
                                <MenuItem Header="{Binding [MenuPreview], Source={x:Static local:Loc.I}}" Click="MenuPreview_Click" FontWeight="SemiBold" InputGestureText="Space"/>
                                <MenuItem x:Name="MenuRescueThis" Click="MenuRescueThis_Click"/>
                                <MenuItem x:Name="MenuOpenThis" Header="{Binding [MenuOpen], Source={x:Static local:Loc.I}}" Click="MenuOpenThis_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuToggleThis" Click="MenuToggleThis_Click"/>
                            </ContextMenu>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <DockPanel Margin="0,0,0,10">
                            <Button local:Ico.Glyph="&#xE8E5;" DockPanel.Dock="Right" Content="{Binding [OpenImage], Source={x:Static local:Loc.I}}" Click="OpenImage_Click" Margin="0"/>
                            <StackPanel>
                                <TextBlock x:Name="ContentSource" Style="{StaticResource H2}" Margin="0"/>
                                <TextBlock x:Name="ContentSummary" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- summary cards -->
                        <UniformGrid x:Name="StatsStrip" Grid.Row="1" Columns="6" Margin="0,0,-8,4">
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#3B82F6" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntFiles" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardFiles], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#16A34A" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntIntact" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardIntact], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#E11D48" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntProblem" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardProblem], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#8B5CF6" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntVideo" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardVideos], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#DB2777" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntPhoto" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardPhotos], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <DockPanel>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#D97706" Opacity="0.95" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock x:Name="CntMusic" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding [CardMusic], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <!-- filters, search, view -->
                        <DockPanel Grid.Row="2" Margin="0,4,0,2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
                                <ComboBox x:Name="SortBox" SelectedIndex="0" MinWidth="128" Height="32" Margin="0,0,8,0" SelectionChanged="SortBox_SelectionChanged" ToolTip="{Binding [SortBy], Source={x:Static local:Loc.I}}">
                                    <ComboBoxItem Content="{Binding [SortName], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [SortNewest], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [SortOldest], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [SortSize], Source={x:Static local:Loc.I}}"/>
                                    <ComboBoxItem Content="{Binding [SortProblems], Source={x:Static local:Loc.I}}"/>
                                </ComboBox>
                                <Grid Width="170" Height="32" Margin="0,0,8,0">
                                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="30,6,8,6"/>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SearchHint" Text="{Binding [Search], Source={x:Static local:Loc.I}}" Foreground="{StaticResource MutedBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <RadioButton x:Name="ViewList" GroupName="view" Style="{StaticResource Chip}" IsChecked="True" Checked="View_Changed" Margin="0,0,4,0"
                                             ToolTip="{Binding [ViewList], Source={x:Static local:Loc.I}}">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}"/>
                                </RadioButton>
                                <RadioButton x:Name="ViewGrid" GroupName="view" Style="{StaticResource Chip}" Checked="View_Changed" Margin="0,0,4,0"
                                             ToolTip="{Binding [ViewGrid], Source={x:Static local:Loc.I}}">
                                    <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource Icons}"/>
                                </RadioButton>
                                <RadioButton x:Name="ViewTree" GroupName="view" Style="{StaticResource Chip}" Checked="View_Changed" Margin="0"
                                             ToolTip="{Binding [ViewTree], Source={x:Static local:Loc.I}}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}"/>
                                </RadioButton>
                            </StackPanel>
                            <WrapPanel x:Name="FilterChips">
                                <RadioButton x:Name="FilterAll" GroupName="filter" Style="{StaticResource Chip}" IsChecked="True" Tag="all" Checked="Filter_Changed"/>
                                <RadioButton x:Name="FilterVideo" GroupName="filter" Style="{StaticResource Chip}" Tag="Video" Checked="Filter_Changed"/>
                                <RadioButton x:Name="FilterImage" GroupName="filter" Style="{StaticResource Chip}" Tag="Image" Checked="Filter_Changed"/>
                                <RadioButton x:Name="FilterAudio" GroupName="filter" Style="{StaticResource Chip}" Tag="Audio" Checked="Filter_Changed"/>
                                <RadioButton x:Name="FilterDocument" GroupName="filter" Style="{StaticResource Chip}" Tag="Document" Checked="Filter_Changed"/>
                                <RadioButton x:Name="FilterProblem" GroupName="filter" Style="{StaticResource Chip}" Tag="problem" Checked="Filter_Changed"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- actions -->
                        <WrapPanel Grid.Row="3">
                            <Button local:Ico.Glyph="&#xE896;" x:Name="RescueSelectedButton" Style="{StaticResource Primary}" Content="{Binding [RescueSelected], Source={x:Static local:Loc.I}}" Click="RescueSelected_Click"/>
                            <Button local:Ico.Glyph="&#xE8B3;" Content="{Binding [SelectAll], Source={x:Static local:Loc.I}}" Click="SelectAll_Click"/>
                            <Button local:Ico.Glyph="&#xE8E6;" Content="{Binding [SelectNone], Source={x:Static local:Loc.I}}" Click="SelectNone_Click"/>
                            <Button local:Ico.Glyph="&#xEDE1;" x:Name="ExtractButton" Content="{Binding [Extract], Source={x:Static local:Loc.I}}" Click="Extract_Click"/>
                            <Button local:Ico.Glyph="&#xE958;" x:Name="IsoButton" Content="{Binding [SaveIso], Source={x:Static local:Loc.I}}" Click="SaveIso_Click"/>
                            <Button local:Ico.Glyph="&#xE8D6;" x:Name="AudioButton" Content="{Binding [SaveAudio], Source={x:Static local:Loc.I}}" Click="SaveAudio_Click"/>
                            <ComboBox x:Name="AudioFormatBox" SelectedIndex="0" MinWidth="110" Margin="0,0,8,8" ToolTip="{Binding [AudioFormat], Source={x:Static local:Loc.I}}">
                                <ComboBoxItem Content="MP3"/>
                                <ComboBoxItem Content="FLAC"/>
                                <ComboBoxItem Content="WAV"/>
                            </ComboBox>
                            <Button local:Ico.Glyph="&#xE8A7;" x:Name="MountButton" Content="{Binding [Mount], Source={x:Static local:Loc.I}}" Click="Mount_Click"/>
                            <Button local:Ico.Glyph="&#xE711;" x:Name="UnmountButton" Content="{Binding [Unmount], Source={x:Static local:Loc.I}}" Click="Unmount_Click" IsEnabled="False"/>
                        </WrapPanel>

                        <!-- files: card list (default) or folder tree -->
                        <Grid Grid.Row="4">
                            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource FileCard}" ContextMenu="{StaticResource FileMenu}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileTree_DoubleClick" PreviewKeyDown="FileList_PreviewKeyDown" PreviewMouseRightButtonDown="FileTree_PreviewRightClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FileNode}">
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="124"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto" MinWidth="96"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="{Binding TileBrush}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{Binding TileFore}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FolderText}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding AgeText}">
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="13" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="11" TextAlignment="Right" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Height="6" CornerRadius="3" Background="#0C111B" Width="120" HorizontalAlignment="Left" ClipToBounds="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="{Binding OkWidth}" Background="{StaticResource OkBrush}"/>
                                                        <Border Width="{Binding ErrWidth}" Background="{StaticResource RetryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding PctText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="5" CornerRadius="11" Padding="10,3" Background="{Binding ChipBack}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipFore}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox x:Name="FileGrid" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource FileTile}" ContextMenu="{StaticResource FileMenu}" ItemsSource="{Binding ItemsSource, ElementName=FileList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileTree_DoubleClick" PreviewKeyDown="FileList_PreviewKeyDown" PreviewMouseRightButtonDown="FileTree_PreviewRightClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FileNode}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0"/>
                                                <Border Width="54" Height="54" CornerRadius="14" Background="{Binding TileBrush}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{Binding TileFore}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,8"/>
                                            <DockPanel>
                                                <TextBlock Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding AgeText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,10"/>
                                            <Border Height="6" CornerRadius="3" Background="#0C111B" ClipToBounds="True" HorizontalAlignment="Left" Width="120">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="{Binding OkWidth}" Background="{StaticResource OkBrush}"/>
                                                    <Border Width="{Binding ErrWidth}" Background="{StaticResource RetryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <DockPanel Margin="0,8,0,0">
                                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="{Binding ChipBack}">
                                                    <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipFore}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                </Border>
                                                <TextBlock Text="{Binding PctShort}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TreeView x:Name="FileTree" Visibility="Collapsed" ContextMenu="{StaticResource FileMenu}" MouseDoubleClick="FileTree_DoubleClick"
                                      SelectedItemChanged="FileTree_SelectedItemChanged" PreviewMouseRightButtonDown="FileTree_PreviewRightClick">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="118"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                                            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="7" Background="{Binding TileBrush}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{Binding TileFore}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DateText}" ToolTip="{Binding AgeText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Grid.Column="5" CornerRadius="10" Padding="9,2" Background="{Binding ChipBack}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipFore}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <TextBlock x:Name="ContentEmpty" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [NoContent], Source={x:Static local:Loc.I}}"/>
                        </Grid>
                        <StackPanel Grid.Row="5" Margin="0,10,0,0">
                            <ProgressBar x:Name="ContentProgress" Maximum="1000" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
                            <TextBlock x:Name="ContentStatus" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- VIDEO -->
                <TabItem Header="{Binding [TabVideo], Source={x:Static local:Loc.I}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding [VideoHint], Source={x:Static local:Loc.I}}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [Quality], Source={x:Static local:Loc.I}}"/>
                                        <ComboBox x:Name="QualityBox" SelectedIndex="1" MinWidth="260">
                                            <ComboBoxItem Content="{Binding [QOriginal], Source={x:Static local:Loc.I}}"/>
                                            <ComboBoxItem Content="{Binding [Q720], Source={x:Static local:Loc.I}}"/>
                                            <ComboBoxItem Content="{Binding [Q1080], Source={x:Static local:Loc.I}}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding [Codec], Source={x:Static local:Loc.I}}"/>
                                        <ComboBox x:Name="CodecBox" SelectedIndex="0" MinWidth="200">
                                            <ComboBoxItem Content="{Binding [CodecH264], Source={x:Static local:Loc.I}}"/>
                                            <ComboBoxItem Content="{Binding [CodecH265], Source={x:Static local:Loc.I}}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding [OutputFolder], Source={x:Static local:Loc.I}}" Margin="0,4,0,2"/>
                                <DockPanel>
                                    <Button local:Ico.Glyph="&#xE8DA;" DockPanel.Dock="Right" Content="{Binding [Choose], Source={x:Static local:Loc.I}}" Click="ChooseVideoFolder_Click" Margin="8,0,0,0"/>
                                    <TextBox x:Name="VideoFolderBox"/>
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <Button local:Ico.Glyph="&#xE896;" x:Name="FfmpegButton" DockPanel.Dock="Right" Content="{Binding [FfmpegDownload], Source={x:Static local:Loc.I}}" Click="DownloadFfmpeg_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="FfmpegText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="VideoList" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VideoItem}">
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="1" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button local:Ico.Glyph="&#xE714;" x:Name="ConvertButton" Style="{StaticResource Primary}" Content="{Binding [Convert], Source={x:Static local:Loc.I}}" Click="Convert_Click"/>
                            <Button local:Ico.Glyph="&#xE8D6;" x:Name="AudioOnlyButton" Content="{Binding [AudioOnly], Source={x:Static local:Loc.I}}" Click="AudioOnly_Click"/>
                            <Button local:Ico.Glyph="&#xE71A;" x:Name="StopVideoButton" Style="{StaticResource Danger}" Content="{Binding [Stop], Source={x:Static local:Loc.I}}" Click="StopVideo_Click" IsEnabled="False"/>
                            <Button local:Ico.Glyph="&#xE958;" Content="{Binding [FromDisc], Source={x:Static local:Loc.I}}" Click="AddDiscVideos_Click"/>
                            <Button local:Ico.Glyph="&#xE710;" Content="{Binding [AddVideos], Source={x:Static local:Loc.I}}" Click="AddVideos_Click"/>
                            <Button local:Ico.Glyph="&#xE74D;" Content="{Binding [Remove], Source={x:Static local:Loc.I}}" Click="RemoveVideo_Click"/>
                            <Button local:Ico.Glyph="&#xE838;" Content="{Binding [OpenFolder], Source={x:Static local:Loc.I}}" Click="OpenVideoFolder_Click"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <!-- HELP -->
                <TabItem Header="{Binding [TabHelp], Source={x:Static local:Loc.I}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding [HelpTitle], Source={x:Static local:Loc.I}}"/>
                                    <TextBlock Text="{Binding [Help1], Source={x:Static local:Loc.I}}" Margin="0,4"/>
                                    <TextBlock Text="{Binding [Help2], Source={x:Static local:Loc.I}}" Margin="0,4"/>
                                    <TextBlock Text="{Binding [Help3], Source={x:Static local:Loc.I}}" Margin="0,4"/>
                                    <TextBlock Text="{Binding [Help4], Source={x:Static local:Loc.I}}" Margin="0,4"/>
                                    <TextBlock Text="{Binding [Help5], Source={x:Static local:Loc.I}}" Margin="0,4"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}">
                                <TextBlock Text="{Binding [HelpSectors], Source={x:Static local:Loc.I}}" Style="{StaticResource Muted}" FontSize="13"/>
                            </Border>
                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding [About], Source={x:Static local:Loc.I}}"/>
                                    <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding [AboutText], Source={x:Static local:Loc.I}}" Margin="0,6"/>
                                    <TextBlock>
                                        <Hyperlink NavigateUri="https://github.com/OmerCarnacar/DVD_360" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AccentHover}">github.com/OmerCarnacar/DVD_360</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
