<Window x:Class="Dvd360.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dvd360.App"
        Title="DVD 360" Width="1000" Height="720" MinWidth="640" MinHeight="480"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="0,0,0,14">
            <Border x:Name="HeaderTile" Width="46" Height="46" CornerRadius="12" Margin="0,0,14,0">
                <TextBlock x:Name="HeaderGlyph" FontFamily="{StaticResource Icons}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="HeaderChip" DockPanel.Dock="Right" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderChipText" FontWeight="SemiBold" FontSize="12.5"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderName" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="HeaderInfo" Style="{StaticResource Muted}" FontSize="12.5"/>
            </StackPanel>
        </DockPanel>

        <!-- stage -->
        <Border Grid.Row="1" CornerRadius="14" Background="#070A11" BorderBrush="#1E2738" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="Picture" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Margin="8"/>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" Visibility="Collapsed"
                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>

                <!-- music: big tile + waveform with a moving playhead -->
                <Grid x:Name="AudioView" Visibility="Collapsed" Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="170" Height="170" CornerRadius="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="72" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Row="1" Height="130" Margin="0,24,0,0" x:Name="WaveHost">
                        <Image x:Name="Waveform" Stretch="Fill" Opacity="0.45"/>
                        <Image x:Name="WavePlayed" Stretch="Fill" HorizontalAlignment="Left">
                            <Image.Clip>
                                <RectangleGeometry x:Name="WaveClip" Rect="0,0,0,130"/>
                            </Image.Clip>
                        </Image>
                        <Rectangle x:Name="WaveHead" Width="2" Fill="White" HorizontalAlignment="Left" Opacity="0.9"/>
                    </Grid>
                </Grid>

                <TextBox x:Name="TextView" Visibility="Collapsed" IsReadOnly="True" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="18"/>

                <!-- busy -->
                <StackPanel x:Name="Busy" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="46" Height="46" Stretch="Uniform" Stroke="#3B82F6" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 23,2 A 21,21 0 1 1 2,23" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="Spin"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock x:Name="BusyText" Style="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="NoPreview" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource Icons}" FontSize="54" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NoPreviewText" Style="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" TextAlignment="Center" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- film strip -->
        <ItemsControl Grid.Row="2" x:Name="Strip" Margin="0,12,0,0" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Padding="0" Margin="0,0,6,0" Click="StripFrame_Click" Tag="{Binding Seconds}" Background="#0A0E16" BorderBrush="#1E2738" Cursor="Hand"
                            ToolTip="{Binding Label}">
                        <Grid>
                            <Image Source="{Binding Image}" Stretch="UniformToFill" Height="62" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#B0000000" CornerRadius="4" Padding="5,1" Margin="4">
                                <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- transport -->
        <DockPanel Grid.Row="3" x:Name="Transport" Margin="0,12,0,0" Visibility="Collapsed">
            <Button x:Name="PlayButton" local:Ico.Glyph="&#xE768;" Style="{StaticResource Primary}" Click="Play_Click" Margin="0,0,12,0" Padding="16,8" MinWidth="110"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="Volume" Width="90" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="Volume_ValueChanged"/>
            </StackPanel>
            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="100" TextAlignment="Right"/>
            <Slider x:Name="Seek" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" PreviewMouseLeftButtonUp="Seek_MouseUp"/>
        </DockPanel>

        <!-- footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="{Binding [Close], Source={x:Static local:Loc.I}}" local:Ico.Glyph="&#xE711;" Click="Close_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="{Binding [SaveFileAs], Source={x:Static local:Loc.I}}" local:Ico.Glyph="&#xE74E;" Click="Save_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="{Binding [OpenExternally], Source={x:Static local:Loc.I}}" local:Ico.Glyph="&#xE8A7;" Click="OpenExternally_Click" Margin="8,0,0,0" IsEnabled="False"/>
            <TextBlock x:Name="Note" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
